# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real credentials.

# Same cluster the public site and the Express API use.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.olt6xic.mongodb.net/?appName=Cluster0
MONGODB_DB=realtyfocus

# Signs the admin session cookie. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
